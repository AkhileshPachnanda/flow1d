# Only needed for mode: "webhook" in config.js. Copy to .env and fill in.
# From Moxo: Template Settings → Start Modes → Webhook

# Path-token auth: paste the full URL (token included)
MOXO_WEBHOOK_URL=https://api.moxo.com/v1/webhooks/incoming/<TEMPLATE_ID>/<PATH_TOKEN>
# API-key auth instead: use the base URL above (no token) and set:
# MOXO_WEBHOOK_API_KEY=

# Role names exactly as they appear in your flow template
ROLE_CLIENT=Client
# ROLE_SIGNATORY=Client Authorized Signatory
# ROLE_FINANCE=Client Finance Contact

# Outgoing webhooks (Moxo → this server). Paste the Secret shown on the endpoint in
# Template Settings → Outgoing Webhooks. Endpoint URL: https://<your-tunnel>/api/moxo-events
# MOXO_EVENTS_SECRET=

PORT=3000
